{
  "command-guard": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "node hooks/guard-command.mjs",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "post-edit-linter": {
    "enabled": true,
    "PostToolUse": [
      {
        "matcher": "edit_file|write_file",
        "hooks": [
          {
            "type": "command",
            "command": "node hooks/post-edit.mjs",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "stop-verifier": {
    "enabled": true,
    "Stop": [
      {
        "type": "command",
        "command": "node hooks/stop-progress.mjs",
        "timeout": 10
      }
    ]
  },
  "notifier": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"/home/ashit/.nvm/versions/node/v22.17.1/bin/node\" \"/home/ashit/.antigravity-ide-server/extensions/kamalpulaparthi.notifier-0.3.1-universal/bin/notifier.js\" dispatch antigravity",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"/home/ashit/.nvm/versions/node/v22.17.1/bin/node\" \"/home/ashit/.antigravity-ide-server/extensions/kamalpulaparthi.notifier-0.3.1-universal/bin/notifier.js\" dispatch antigravity",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"/home/ashit/.nvm/versions/node/v22.17.1/bin/node\" \"/home/ashit/.antigravity-ide-server/extensions/kamalpulaparthi.notifier-0.3.1-universal/bin/notifier.js\" dispatch antigravity",
            "timeout": 10
          }
        ]
      }
    ]
  }
}